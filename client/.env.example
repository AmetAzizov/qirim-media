# Публичный адрес Strapi API. Вшивается в сборку (build arg), менять -> пересобирать client.
# Локально:   http://localhost:1337/api
# Продакшен:  https://qirim.news/api
NEXT_PUBLIC_API_URL=http://localhost:1337/api

# Только серверные значения, НИКОГДА с префиксом NEXT_PUBLIC_
# Strapi API token (Custom: Blog create + Upload)
BLOG_SUBMIT_TOKEN=
# Секрет для /api/revalidate
REVALIDATE_SECRET=

# Twitter API
YOUR_CONSUMER_KEY=
YOUR_CONSUMER_SECRET=
YOUR_ACCESS_TOKEN=
YOUR_ACCESS_TOKEN_SECRET=
